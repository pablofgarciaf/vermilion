@import "tailwindcss";
@custom-variant dark (.dark &);

@theme {
  --color-void: #0A0A0B;
  --color-coconut: #F7F5F2;
  --color-brand-red: #8F1010;
  --color-vermilion: #8F1010;
  --color-brand-cyan: #86D2D9;

  /* Accessibility Overrides to fix Contrast errors globally */
  --color-emerald-600: #065f46;
  /* Matches tailwind emerald-800, contrast 7.2 on white */
  --color-emerald-500: #047857;
  /* Matches tailwind emerald-700, contrast 4.9 on white */
  --color-zinc-400: #52525b;
  /* Matches zinc-600, contrast 5.7 on white */
  --color-zinc-500: #3f3f46;
  /* Matches zinc-700, contrast 7.5 on white */

  --font-editorial: "Playfair Display", serif;
  --font-sans: "Inter", sans-serif;
}


@layer base {
  :root {
    --background: #FBFBFA;
    /* Blanco Lino / Arena Suave Boutique */
    --foreground: #1C1F1E;
    /* Gris Grafito Oscuro */
    --primary: #C49B45;
    /* Ocre Metálico / Oro Sol */
    --card: #F1F3F2;
    /* Gris Glaciar Claro */
  }

  .dark {
    --background: #0F172A;
    /* Azul Marino Profundo Vibrante - más claro y brillante */
    --foreground: #FFFFFF;
    /* Blanco Puro */
    --primary: #10B981;
    /* Verde Esmeralda Vibrante */
    --card: #1E293B;
    /* Azul Gris Profundo para tarjetas */
    --basalt: #0F172A;
    /* Azul Marino Profundo */

    /* Colores vibrantemente mejorados para contraste */
    --color-zinc-50: #F8FAFC;
    --color-zinc-100: #F1F5F9;
    --color-zinc-200: #E2E8F0;
    --color-zinc-300: #CBD5E1;
    --color-zinc-400: #94A3B8;
    --color-zinc-500: #64748B;
    --color-zinc-600: #475569;
    --color-zinc-700: #334155;
    --color-zinc-800: #1E293B;
    --color-zinc-900: #0F172A;
    --color-zinc-950: #020617;

    --color-emerald-50: #F0FDF4;
    --color-emerald-100: #DCFCE7;
    --color-emerald-200: #BBFCDC;
    --color-emerald-300: #86EFAC;
    --color-emerald-400: #4ADE80;
    --color-emerald-500: #22C55E;
    --color-emerald-600: #16A34A;
    --color-emerald-700: #15803D;
    --color-emerald-800: #166534;
    --color-emerald-900: #145231;
    --color-emerald-950: #052E16;
  }

  /* Delineado sutil y elegante para titulos blancos sobre heroes fotograficos:
     un trazo oscuro casi imperceptible que separa la letra del fondo sin verse
     como una sombra difusa (evita el efecto "drop-shadow" plano). */
.hero-title-shadow {
  text-shadow:
    0 1px 2px rgba(0, 0, 0, 0.55),
    0 0 1px rgba(0, 0, 0, 0.85);
}

/* Light Mode Luxury */
.theme-luxury {
  --background: #FAFAF5 !important;
  /* Champagne/Ivory Light */
  --foreground: #111111 !important;
  --primary: #B8860B !important;
  --card: #FFFFFF !important;
  --basalt: #2D2D2D !important;

  /* Make the entire page use the Luxury Serif font */
  --font-inter: var(--font-playfair) !important;
  --font-sans: var(--font-playfair) !important;

  /* Override Emerald with Gold */
  --color-emerald-50: #fbf9f2 !important;
  --color-emerald-100: #f4ecce !important;
  --color-emerald-200: #eadb9d !important;
  --color-emerald-300: #dec668 !important;
  --color-emerald-400: #d2b036 !important;
  --color-emerald-500: #c19a27 !important;
  --color-emerald-600: #a77c1d !important;
  --color-emerald-700: #855b1b !important;
  --color-emerald-800: #714a1e !important;
  --color-emerald-900: #603e1e !important;
  --color-emerald-950: #37200e !important;

  /* Override Zinc background levels */
  --color-zinc-50: #FCFBF7 !important;
  --color-zinc-100: #F3F0E6 !important;
  --color-zinc-900: #111111 !important;
  --color-zinc-950: #050505 !important;
}

/* Dark Mode Luxury */
.dark .theme-luxury,
.theme-luxury.dark {
  --background: #050505 !important;
  /* Obsidian Black */
  --foreground: #FFFFF0 !important;
  /* Ivory Text */
  --primary: #D4AF37 !important;
  /* Bright Gold */
  --card: #0A0A0A !important;
  --basalt: #000000 !important;

  /* Make the entire page use the Luxury Serif font */
  --font-inter: var(--font-playfair) !important;
  --font-sans: var(--font-playfair) !important;

  /* Emerald -> Dark Gold (Preserving lightness scale for contrast) */
  --color-emerald-50: #fcfbf5 !important;
  --color-emerald-100: #f8f3dc !important;
  --color-emerald-200: #eedda1 !important;
  --color-emerald-300: #e3c460 !important;
  --color-emerald-400: #d8aa28 !important;
  --color-emerald-500: #D4AF37 !important;
  --color-emerald-600: #B8860B !important;
  --color-emerald-700: #936607 !important;
  --color-emerald-800: #78520d !important;
  --color-emerald-900: #654411 !important;
  --color-emerald-950: #3c2606 !important;

  /* Zinc -> Dark Theme overrides */
  --color-zinc-50: #fafafa !important;
  --color-zinc-100: #f4f4f5 !important;
  --color-zinc-900: #18181b !important;
  --color-zinc-950: #09090b !important;
}

body {
  background-color: var(--background);
  color: var(--foreground);
  font-family: var(--font-inter), system-ui, -apple-system, sans-serif;
}

/* Brillo sutil tipo laca sobre el azul marino del modo oscuro: un resplandor
     radial muy tenue arriba de la pagina que evita que el azul se sienta plano
     u opaco (efecto "pintura vieja"), sin oscurecer ni cambiar el contenido. */

h1,
h2,
h3,
h4,
h5,
h6,
.font-serif {
  font-family: var(--font-playfair), Georgia, serif;
}

/* Paper Background */
.paper-bg {
  position: relative;
  overflow-x: clip;
  background-color: var(--background);
}

.paper-bg::before {
  content: "";
  position: fixed;
  inset: 0;
  width: 100vw;
  height: 100vh;
  z-index: -1;
  pointer-events: none;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
  background-size: 200px 200px;
  background-position: center;
  background-repeat: repeat;
  opacity: 0.15;
  /* Subtle paper texture */
  mix-blend-mode: multiply;
}

.dark .paper-bg::before {
  opacity: 0.15;
  mix-blend-mode: overlay;
}

/* Glassmorphism Panel / Bento Box utilities */
.glass-panel {
  background: rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(24px);
  border: 1px solid rgba(255, 255, 255, 0.5);
  box-shadow: 0 10px 40px -10px rgba(0, 0, 0, 0.05);
  transition: all 0.3s ease;
}

.dark .glass-panel {
  background: rgba(10, 15, 25, 0.55);
  backdrop-filter: blur(24px);
  border: 1px solid rgba(255, 255, 255, 0.05);
  box-shadow: 0 10px 40px -10px rgba(0, 0, 0, 0.3);
}

.glass-input {
  background: rgba(255, 255, 255, 0.6);
  border: 1px solid rgba(0, 0, 0, 0.1);
  color: #09090B;
}

.dark .glass-input {
  background: rgba(0, 0, 0, 0.4);
  border: 1px solid rgba(255, 255, 255, 0.1);
  color: #FAFAFA;
}

/* 
 * Hide Google Translate Toolbar completely 
 * The element.js script injects a banner at the top and shifts the body down.
 * We hide the banner and force the body back to top: 0.
 */
.goog-te-banner-frame.skiptranslate,
.goog-te-banner-frame,
.goog-te-gadget-icon,
#goog-gt-tt,
.goog-te-balloon-frame,
.VIpgJd-ZVi9od-ORHb-OEVmcd,
.VIpgJd-ZVi9od-aZ2wEe-wOHMyf,
.VIpgJd-ZVi9od-SmfZ-OEVmcd {
  display: none !important;
  visibility: hidden !important;
  height: 0 !important;
  overflow: hidden !important;
}

.skiptranslate {
  display: none !important;
  visibility: hidden !important;
  height: 0 !important;
}

body {
  top: 0px !important;
  position: static !important;
  margin-top: 0px !important;
  overflow-x: clip !important;
  max-width: 100vw !important;
}

html {
  margin-top: 0px !important;
  overflow-x: clip !important;
  max-width: 100vw !important;
}

/* Hide the tooltip that appears on hover when translated */
#goog-gt-tt,
.goog-te-balloon-frame {
  display: none !important;
}

.goog-text-highlight {
  background-color: transparent !important;
  box-shadow: none !important;
}

/* Custom scrollbar */
::-webkit-scrollbar {
  width: 6px;
}

::-webkit-scrollbar-track {
  background: transparent;
}

::-webkit-scrollbar-thumb {
  background: #D4D4D8;
  border-radius: 9999px;
}

::-webkit-scrollbar-thumb:hover {
  background: #059669;
}

.dark ::-webkit-scrollbar-thumb {
  background: #3f3f46;
}

.dark ::-webkit-scrollbar-thumb:hover {
  background: #10B981;
}

/* Smooth scroll */
html {
  scroll-behavior: smooth;
}

/* Premium fade-in-up animation for section reveals */
@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(24px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.animate-fade-in-up {
  animation: fadeInUp 0.6s ease-out forwards;
}

/* Shimmer skeleton for loading states */
@keyframes shimmer {
  0% {
    background-position: -200% 0;
  }

  100% {
    background-position: 200% 0;
  }
}

.skeleton {
  background: linear-gradient(90deg, #f4f4f5 25%, #e4e4e7 50%, #f4f4f5 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
}

.dark .skeleton {
  background: linear-gradient(90deg, #27272a 25%, #3f3f46 50%, #27272a 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
}

/* Ring glow for featured card */
.ring-glow-emerald {
  box-shadow: 0 0 0 2px rgba(16, 185, 129, 0.3), 0 0 30px rgba(16, 185, 129, 0.1);
}

/* Global text size increases exclusively for mobile devices */
@media (max-width: 767px) {
  .text-xs {
    font-size: 0.875rem !important;
    /* Equivale a text-sm (14px) */
    line-height: 1.25rem !important;
  }

  .text-sm {
    font-size: 1rem !important;
    /* Equivale a text-base (16px) */
    line-height: 1.5rem !important;
  }
}

/* Google Translate Frame Suppression - Prevents DOM Layout Thrashing & CPU Lock */
.goog-te-banner-frame,
.skiptranslate>iframe {
  display: none !important;
  visibility: hidden !important;
  height: 0 !important;
}

body {
  top: 0px !important;
}


/* ============================================================
   MODO VIP — capa de exclusividad, elegancia y majestuosidad.
   Se monta encima de los tokens .theme-luxury ya definidos arriba
   (paleta oro + tipografia serif). Solo se pinta en booking,
   checkout y ficha de tour: lo controla LuxuryThemeProvider.
   ============================================================ */

.theme-luxury {
  --lux-gold: #C9A227;
  --lux-gold-soft: rgba(201, 162, 39, 0.28);
  --lux-gold-line: rgba(201, 162, 39, 0.45);
}

/* Respiracion tipografica: los titulos se abren y se vuelven serif */
.theme-luxury h1,
.theme-luxury h2,
.theme-luxury h3 {
  font-family: var(--font-playfair), Georgia, serif;
  letter-spacing: 0.01em;
  font-weight: 500;
}

/* Los micro-titulos en mayuscula ganan aire: lee como papeleria de lujo */
.theme-luxury .uppercase {
  letter-spacing: 0.14em;
}

/* Filo dorado en las superficies: sustituye el borde gris por una hairline */
.theme-luxury [class*="rounded-2xl"][class*="border"],
.theme-luxury [class*="rounded-xl"][class*="border"] {
  border-color: var(--lux-gold-line);
}

/* Profundidad calida en vez de sombra gris plana */
.theme-luxury [class*="shadow-2xl"],
.theme-luxury [class*="shadow-xl"] {
  box-shadow:
    0 1px 0 rgba(255, 255, 255, 0.04) inset,
    0 18px 50px -12px rgba(0, 0, 0, 0.55),
    0 0 0 1px var(--lux-gold-soft);
}

/* El boton principal deja de ser plano y se vuelve metal pulido */
.theme-luxury button:not(.cal-day)[class*="bg-emerald-600"],
.theme-luxury button:not(.cal-day)[class*="from-emerald"],
.theme-luxury a:not(.cal-day)[class*="from-emerald"],
.theme-luxury a:not(.cal-day)[class*="bg-emerald-600"],
.theme-luxury .btn-luxury-cta {
  background-image: linear-gradient(135deg, #8A6B14 0%, #C9A227 45%, #E8D07A 55%, #C9A227 70%, #8A6B14 100%);
  background-size: 220% 100%;
  background-position: 0% 0%;
  border: 1px solid var(--lux-gold-line);
  color: #12100A;
  text-shadow: none;
  transition: background-position 700ms ease, box-shadow 400ms ease, transform 200ms ease;
}

.theme-luxury button:not(.cal-day)[class*="bg-emerald-600"]:hover,
.theme-luxury button:not(.cal-day)[class*="from-emerald"]:hover,
.theme-luxury a:not(.cal-day)[class*="from-emerald"]:hover,
.theme-luxury a:not(.cal-day)[class*="bg-emerald-600"]:hover,
.theme-luxury .btn-luxury-cta:hover {
  background-position: 100% 0%;
  box-shadow: 0 10px 34px -8px rgba(201, 162, 39, 0.65);
  transform: translateY(-1px);
}

/* Anillo de foco dorado, coherente con el resto */
.theme-luxury *:focus-visible {
  outline: 2px solid var(--lux-gold);
  outline-offset: 2px;
}

/* La opcion VIP seleccionada se corona con un halo tenue */
.theme-luxury [class*="border-amber"] {
  box-shadow: 0 0 0 1px var(--lux-gold-soft), 0 0 28px -6px rgba(201, 162, 39, 0.35);
}

/* El precio total es el heroe de la pagina: que pese */
.theme-luxury .lux-amount {
  font-family: var(--font-playfair), Georgia, serif;
  letter-spacing: -0.01em;
  background: linear-gradient(180deg, #F0DFA0 0%, #C9A227 60%, #9A7A18 100%);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

/* Filete superior dorado en el resumen de compra */
.theme-luxury .lux-panel {
  position: relative;
}

.theme-luxury .lux-panel::before {
  content: '';
  position: absolute;
  inset: 0 0 auto 0;
  height: 2px;
  background: linear-gradient(90deg, transparent, var(--lux-gold), transparent);
  opacity: 0.85;
}

/* Quien prefiere menos movimiento, no lo sufre */
@media (prefers-reduced-motion: reduce) {

  .theme-luxury button[class*="bg-emerald"],
  .theme-luxury a[class*="bg-emerald"] {
    transition: none;
  }

  .theme-luxury button[class*="bg-emerald"]:hover,
  .theme-luxury a[class*="bg-emerald"]:hover {
    transform: none;
  }
}