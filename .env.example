# ==========================================
# Vermilion Routes Environment Configuration
# ==========================================

# Base URL for redirects and absolute links
NEXT_PUBLIC_BASE_URL=https://www.vermilionroutes.com

# ------------------------------------------
# Stripe Payments Configuration
# ------------------------------------------
# Secret or Restricted API Key (rk_test_... or sk_test_...)
STRIPE_SECRET_KEY=sk_test_your_secret_key_here

# Publishable Key (pk_test_...)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Webhook Signing Secret (whsec_...) from Stripe Dashboard -> Developers -> Webhooks
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret_here

# ------------------------------------------
# PayPal Business Ecuador Configuration
# ------------------------------------------
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here
PAYPAL_MODE=sandbox


# ------------------------------------------
# Firebase Configuration
# ------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ------------------------------------------
# Admin & Concierge
# ------------------------------------------
ADMIN_EMAIL=
ADMIN_PASSWORD=
NEXT_PUBLIC_ADMIN_EMAIL=
NEXT_PUBLIC_ADMIN_PASSWORD=

# ------------------------------------------
# AI & Operations
# ------------------------------------------
AI_PROVIDER=gemini
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
GLM_API_KEY=
N8N_WEBHOOK_URL=

# ------------------------------------------
# Email (SMTP)
# ------------------------------------------
SMTP_HOST=
SMTP_PORT=
SMTP_EMAIL=
SMTP_PASSWORD=

# ------------------------------------------
# Firebase Admin (server-only, never exposed to the browser)
# ------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ------------------------------------------
# WhatsApp Cloud API (CRM webhook)
# ------------------------------------------
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_TOKEN=
